<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Dictation. Requested at runtime as well; without the runtime grant the
         recorder silently returns no samples rather than failing loudly. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- No VR features are declared on purpose. Declaring headtracking or an
         immersive intent category is what makes Horizon OS launch an app
         exclusively; a plain 2D app gets a window instead, and windows
         multitask. -->

    <application
        android:allowBackup="false"
        android:label="linux-vr"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- One launcher entry, however many monitors the host has.
             The first instance asks the host how many screens exist and opens
             one more window per extra screen. documentLaunchMode="always" is
             what gives each instance its own task, and therefore its own
             window in the shell.

             A fixed set of launcher entries was tried first and is wrong twice
             over: it shows four entries to someone with one monitor, and
             activity aliases do not deliver their own meta-data — getActivityInfo
             resolves an alias to its target and the per-alias value is lost. -->
        <activity
            android:name=".PanelActivity"
            android:exported="true"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">

            <!-- Sized to match the stream, not merely to look right.
                 At 1280dp the shell gave a 1600x900 window for a 2560x1440
                 stream: everything was downscaled to 0.625 before it reached
                 the eye, turning a 15 px font into 9 px. Text lost there cannot
                 be recovered by enlarging it afterwards.

                 The shell renders roughly 1.25 px per dp here, so 2048dp lands
                 near 2560 px and the picture arrives one pixel per pixel. -->
            <layout
                android:defaultWidth="2048dp"
                android:defaultHeight="1152dp"
                android:minWidth="480dp"
                android:minHeight="270dp"
                android:gravity="center" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Controls in a window of their own rather than over the desktop:
             the shell already places and stacks windows, so the user puts this
             one where it does not get in the way. -->
        <activity
            android:name=".ControlActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateHidden"
            android:documentLaunchMode="always"
            android:resizeableActivity="true"
            android:taskAffinity="dev.butschster.linuxvr.panel.controls"
            android:label="linux-vr controls"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode">
            <layout
                android:defaultWidth="820dp"
                android:defaultHeight="96dp"
                android:minWidth="360dp"
                android:minHeight="72dp"
                android:gravity="bottom" />
        </activity>
    </application>

</manifest>
