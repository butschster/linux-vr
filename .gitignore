# Android / Gradle
.gradle/
build/
local.properties
*.apk
*.aab
*.keystore
captures/

# CMake / NDK
.cxx/
cmake-build-*/

# IDE
.idea/
*.iml
.vscode/

# Generated test material, hundreds of megabytes. Anchored to the root so it
# does not swallow the app's own assets directory. Nothing needs it any more —
# the file-playback path predates live streaming — but a stray render should
# still never reach a commit.
/assets/
*.mp4
*.png
# …except the app's own artwork, which is source, not output.
!client/app/src/main/res/**/*.png

# The server binary, built by `make server`
/host/linux-vr-server

# External sources, if anything is ever cloned here again
vendor/

# Secrets — nothing should reach here anyway, but just in case
.env
*.pem
*.key
*.crt

*.log
