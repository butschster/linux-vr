<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 6DoF tracking is required: the layer is pinned to world coordinates -->
    <uses-feature
        android:name="android.hardware.vr.headtracking"
        android:required="true"
        android:version="1" />

    <!-- Without this line Horizon OS blocks launch with a "controllers
         required" dialog whenever the user is working with hands. For a VR
         desktop that is the normal case, not the exception: the controllers
         are on the desk. -->
    <uses-feature
        android:name="oculus.software.handtracking"
        android:required="false" />
    <uses-permission android:name="com.oculus.permission.HAND_TRACKING" />

    <!-- Passthrough is gated behind this declaration: without it the
         XR_FB_passthrough extension is not even listed by the runtime, and the
         only environment blend mode offered is OPAQUE. A screen floating in the
         real room reads as a window; the same screen on black reads as a game
         that has taken over the headset. -->
    <uses-feature
        android:name="com.oculus.feature.PASSTHROUGH"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="linux-vr">

        <meta-data
            android:name="com.oculus.supportedDevices"
            android:value="quest3|quest3s" />

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:excludeFromRecents="false"
            android:configChanges="density|keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">

            <meta-data
                android:name="android.app.lib_name"
                android:value="linuxvr" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- IMMERSIVE_HMD launches straight into VR, skipping the 2D panel -->
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
