# Android / Gradle
.gradle/
build/
local.properties
*.apk
*.aab
*.keystore
captures/

# CMake / NDK
.cxx/
cmake-build-*/

# IDE
.idea/
*.iml
.vscode/

# Generated test material — produced by scripts in host/, hundreds of megabytes.
# Anchored to the root so it does not swallow the app's own assets directory.
/assets/
*.mp4
*.png
# …except the app's own artwork, which is source, not output.
!client/app/src/main/res/**/*.png

# The server binary, built by `make server`
/host/linux-vr-server

# External sources — cloned per the instructions in docs/gotchas.md
vendor/

# Secrets — nothing should reach here anyway, but just in case
.env
*.pem
*.key
*.crt

*.log
